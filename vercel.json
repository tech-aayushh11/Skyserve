{
  "version": 2,
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.js?__path=/api/:match*"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.js?__path=/healthz"
    }
  ]
}
