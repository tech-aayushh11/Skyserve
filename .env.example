# SKYSERVE Mission Control — Environment Configuration Template
# Copy this file to .env and fill in real values before starting the server.

# Runtime mode: development | production
NODE_ENV=development

# Port the HTTP server listens on (default: 8080)
PORT=8080

# Data directory — point to a mounted persistent volume in production (e.g. /data)
# All users, sessions, audit logs, and daily backups live here.
# Default: ./data (relative to server.js)
DATA_DIR=./data

# Seed admin initial passwords (read ONCE on first run when users.json is absent)
# Must satisfy policy: min 10 chars, uppercase, lowercase, digit, symbol.
# Leave blank to auto-generate a random password (printed once to console).
ADMIN_AAYUSH_PASSWORD=
ADMIN_GAYATRI_PASSWORD=

# Session secret — reserved for future HMAC-signed token upgrades
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
